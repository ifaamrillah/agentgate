#!/usr/bin/env bash
# Tes seluruh workspace. Tes database berjalan berurutan (--test-threads=1) karena berbagi
# satu database test yang di-truncate; diatur di sini supaya tidak bisa lupa per tes.
# Argumen diteruskan sebagai filter: bin/test reset_token
set -euo pipefail
. "$(dirname "$0")/_lib.sh"
ag_load_env
DATABASE_URL="$TEST_DATABASE_URL"
export DATABASE_URL
AG_WORKDIR=/workspace/server ag_exec bash -c '
  set -e
  if [ -d migration ]; then cargo loco db migrate -e test >/dev/null 2>&1 || cargo loco db migrate -e test; fi
  cd /workspace && cargo test --workspace -- --test-threads=1 "$@"' bash "$@"
