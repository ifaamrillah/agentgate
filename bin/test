#!/usr/bin/env bash
# Tes seluruh workspace lewat cargo nextest, paralel. Setiap tes berjalan di prosesnya sendiri dan
# tes database memakai database slot-nya sendiri (config/test.yaml): `<db test>_s0` ..
# `<db test>_s<N-1>`. Slot 0 dimigrasi, lalu slot lain di-clone darinya (CREATE DATABASE TEMPLATE)
# setiap run, jadi selalu berskema terbaru.
#
# Argumen diteruskan ke nextest sebagai filter: bin/test reset_token
# Saat mengerjakan fitur, jalankan tes yang relevan saja (mis. bin/test tickets::mockup); suite
# penuh cukup sebelum commit akhir/merge (bin/ci).
# Jumlah tes paralel: AG_TEST_THREADS (default 8). Batas koneksi Postgres bersama: 300.
set -euo pipefail
. "$(dirname "$0")/_lib.sh"
ag_load_env
threads="${AG_TEST_THREADS:-8}"
case "$threads" in '' | *[!0-9]* | 0) ag_die "AG_TEST_THREADS harus angka >= 1" ;; esac
# config/test.yaml membaca TEST_DATABASE_URL (diteruskan ag_exec), bukan DATABASE_URL.
AG_WORKDIR=/workspace/server ag_exec bash -c '
  set -e
  threads="$1"; shift
  if [ -d migration ]; then
    db="${TEST_DATABASE_URL##*/}"
    admin="${TEST_DATABASE_URL%/*}/postgres"
    psql -qtAc "SELECT 1 FROM pg_database WHERE datname = '"'"'${db}_s0'"'"'" "$admin" | grep -q 1 \
      || psql -qc "CREATE DATABASE \"${db}_s0\"" "$admin"
    # Slot 0 dimigrasi (config test tanpa nextest = slot 0) lalu menjadi template slot lainnya.
    # Output migrasi hanya ditampilkan bila gagal.
    cargo loco db migrate -e test >/tmp/ag-migrate.log 2>&1 || { cat /tmp/ag-migrate.log >&2; exit 1; }
    # Satu perintah per baris lewat stdin: CREATE/DROP DATABASE tidak boleh di dalam transaksi.
    for i in $(seq 1 $((threads - 1))); do
      printf "DROP DATABASE IF EXISTS \"%s_s%s\" WITH (FORCE);\nCREATE DATABASE \"%s_s%s\" TEMPLATE \"%s_s0\";\n" \
        "$db" "$i" "$db" "$i" "$db"
    done | psql -q -v ON_ERROR_STOP=1 "$admin" >/dev/null
  fi
  cd /workspace && cargo nextest run --workspace --test-threads "$threads" "$@"' bash "$threads" "$@"
