#!/usr/bin/env bash
# Pemeriksaan lengkap sebelum merge. CI remote (GitHub Actions) memanggil script ini,
# bukan mendefinisikan ulang langkahnya.
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/_lib.sh
ag_load_env

step() { printf '\n==> %s\n' "$*"; }

step "tes script bin/"
for t in bin/tests/*_test.sh; do bash "$t"; done

step "arah dependensi antar-layer"
bin/check-layers
# common/ dan models/ ada di crate agentgate-models: arah common -> models tetap dicek teks;
# arah models -> layer server dijamin compiler (crate models tidak bergantung pada server).
bin/check-layers server/models/src

step "cargo fmt / hakari / clippy / deny"
ag_exec bash -c '
  set -e
  cargo fmt --all --check
  # workspace-hack harus sesuai dependency terkini (lihat .config/hakari.toml).
  cargo hakari generate --diff
  cargo hakari manage-deps --dry-run
  cargo hakari verify
  cargo clippy --workspace --all-targets --locked -- -D warnings
  # Feature `semantic` (fastembed, R2) tidak dipakai tes; pastikan tetap terkompilasi bersih.
  cargo clippy -p agentgate-server --features semantic --all-targets --locked -- -D warnings
  cargo deny --log-level error check'

step "build CSS"
bin/tailwind --minify

step "tes"
bin/test

printf '\nbin/ci: semua hijau\n'
