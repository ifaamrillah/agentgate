# Salin ke deploy/.env lalu isi. File .env tidak pernah di-commit (.gitignore).
# Penjelasan tiap variabel: docs/admin/konfigurasi.md.

# --- Domain & image ---
APP_DOMAIN=agentgate.example.com
# Domain pratinjau mockup HTML; host WAJIB berbeda dari APP_DOMAIN (bukan subpath).
PREVIEW_DOMAIN=preview.agentgate-usercontent.example.com
APP_URL=https://agentgate.example.com
PREVIEW_URL=https://preview.agentgate-usercontent.example.com
ACME_EMAIL=ops@example.com
AGENTGATE_IMAGE=agentgate-rs-server:latest

# --- Secret aplikasi (wajib, tanpa default) ---
# openssl rand -base64 64 | tr -d '\n'
SESSION_SECRET=
# openssl rand -base64 32   (jangan diganti setelah ada user dengan 2FA)
ENCRYPTION_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Agent Gate <noreply@example.com>

# --- Storage file aplikasi (S3-compatible) ---
# Kosongkan S3_ENDPOINT di compose bila memakai AWS S3 asli; default SeaweedFS lokal http://s3:8333.
S3_BUCKET=agentgate
S3_REGION=us-east-1
# openssl rand -hex 12 / openssl rand -hex 24
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Login Google/GitHub (opsional; kosong = tombol tersembunyi) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Operasi instance (opsional) ---
# Email (koma) yang boleh membuka /system (Status sistem).
SYSTEM_ADMIN_EMAILS=
# Token Prometheus untuk /_metrics (scrape dari jaringan internal: http://web:5150/_metrics).
METRICS_TOKEN=
# Basis unduhan rilis CLI, mis. https://github.com/ORG/REPO/releases/latest/download
CLI_RELEASE_URL=
CLI_MIN_VERSION=0.1.0
LOG_LEVEL=info

# --- Pool database (lihat deploy/README.md) ---
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
WEB_REPLICAS=1

# --- Backup (WAJIB di luar VPS ini) ---
BACKUP_REMOTE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKUP_REMOTE_REGION=eu-central-003
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_PREFIX=agentgate
BACKUP_REMOTE_ACCESS_KEY_ID=
BACKUP_REMOTE_SECRET_ACCESS_KEY=
# Retensi: semua dump harian 14 hari + dump pertama tiap bulan disimpan 6 bulan.
BACKUP_RETENTION_DAYS=14
BACKUP_MONTHLY_MONTHS=6
# Jam UTC backup harian (19 = 02.00 WIB).
BACKUP_HOUR_UTC=19
# Hanya tampilan di Status sistem.
BACKUP_TARGET=s3://BUCKET/agentgate
BACKUP_SCHEDULE_LABEL=setiap hari 02.00 WIB

# Error tracking Sentry (opsional; kosong = mati). Lihat docs/admin/operasi.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# GitHub App instance (opsional; semua kosong = hanya PAT). Lihat docs/admin/github-app.md.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Code graph (R2): clone dangkal + model embedding di volume `cache` (opsional).
# GRAPH_CLONE_HISTORY_MONTHS=12
# GRAPH_CLONE_MAX_MB=1024
# GRAPH_EMBEDDING_ENABLED=true
