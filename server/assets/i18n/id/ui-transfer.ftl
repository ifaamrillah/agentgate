# Error berkas dan pemetaan
csv-empty = Berkas kosong. Pilih berkas CSV.
csv-too-large = Berkas lebih dari 20 MB. Pecah menjadi beberapa berkas.
csv-not-utf8 = Berkas bukan UTF-8. Simpan ulang sebagai "CSV UTF-8" lalu unggah lagi.
csv-invalid = Berkas CSV tidak bisa dibaca. Periksa tanda kutip dan pemisahnya.
csv-too-many-rows = Berkas lebih dari 5.000 baris. Pecah menjadi beberapa berkas.
csv-no-rows = Berkas hanya berisi header, tidak ada baris untuk diimpor.
csv-not-csv = Berkas ini bukan CSV teks.
csv-project-required = Pilih project tujuan.
csv-title-required = Petakan satu kolom ke Judul.
csv-field-twice = Satu field hanya boleh dipetakan dari satu kolom (kecuali Label).
csv-storage-failed = Berkas gagal disimpan. Silakan coba lagi.
csv-not-draft = Impor ini sudah dijalankan atau dibatalkan.
csv-error-access = Pembuat impor tidak lagi punya akses ke project tujuan.
csv-error-source = Berkas sumber impor tidak ditemukan lagi.

# Catatan per baris ($a, $b = nilai dari berkas atau nama stage)
csv-skip-title-empty = Judul kosong, dilewati
csv-skip-duplicate = Baris duplikat dari baris { $a }, dilewati
csv-skip-alias-taken = Kode lama “{ $a }” sudah dipakai, dilewati
csv-skip-failed = Tiket gagal dibuat, dilewati
csv-warn-assignee = Penerima “{ $a }” bukan anggota project, dikosongkan
csv-warn-status-mapped = Status “{ $a }” dipetakan ke { $b }
csv-warn-status-unknown = Status “{ $a }” tidak dikenal, masuk ke { $b }
csv-warn-status-gated = Stage { $a } punya gate sebelumnya, masuk ke { $b }
csv-warn-type = Tipe “{ $a }” tidak dikenal, memakai tipe bawaan
csv-warn-priority = Prioritas “{ $a }” tidak dikenal, memakai Sedang
csv-warn-points = Story point “{ $a }” bukan angka, dikosongkan
csv-warn-date = Tanggal “{ $a }” tidak dikenali, dikosongkan
csv-warn-sprint = Sprint “{ $a }” tidak ditemukan, dikosongkan
csv-warn-label-new = Label “{ $a }” dibuat sebagai label baru
csv-warn-label-dropped = Label “{ $a }” terlalu panjang, dibuang
csv-warn-truncated = Isi { $a } terlalu panjang, dipotong
